#X3D V3.3 utf8
PROFILE Immersive

NavigationInfo { type [ "EXAMINE", "ANY" ] }

Background { skyColor [ 0.6 0.75 0.9 ] }


Viewpoint {
  position 0 22 75
  orientation 1 0 0 -0.2
}

DirectionalLight { direction -1 -1 -1 }

# Transform {
