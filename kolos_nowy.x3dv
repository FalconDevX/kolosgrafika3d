#góra

Shape {
  appearance Appearance { material Material { diffuseColor 0.95 0.95 1 } }
  geometry IndexedFaceSet {
    solid FALSE
    coord Coordinate {
      point [ -40 0 15, 40 0 15, 40 0 -75, -40 0 -75, -40 40 -75, 40 40 -75 ]
    }
    coordIndex [ 0 1 2 3 -1, 3 2 5 4 -1, 0 1 5 4 -1, 0 3 4 -1, 1 2 5 -1 ]
  }
}

#słupki

Transform {
  translation 7 1.33 12
  children DEF Slup Group {
    children [
      Transform {
        translation 0 0.2 0
        children Shape {
          appearance Appearance { material Material { diffuseColor 0.3 0.3 0.3 } }
          geometry Box { size 1 0.4 1 }
        }
      }
      Transform {
        translation 0 3 0
        children Shape {
          appearance Appearance { material Material { diffuseColor 0.5 0.5 0.55 } }
          geometry Cylinder { radius 0.2 height 6 }
        }
      }
      Transform {
        translation 0 6 0
        children Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.6 0.1 } }
          geometry Box { size 2.5 0.3 0.4 }
        }
      }
      Transform {
        translation 0 6.25 0
        rotation 1 0 0 1.57
        children Shape {
          appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } }
          geometry Cylinder { radius 0.25 height 0.6 }
        }
      }
    ]
  }
}

Transform { translation 7 11.11 -10 children USE Slup }
Transform { translation 7 20.89 -32 children USE Slup }
Transform { translation 7 30.67 -54 children USE Slup }
Transform { translation 7 38.67 -72 children USE Slup }

#linki

Shape {
  appearance Appearance { material Material { emissiveColor 0.1 0.1 0.1 } }
  geometry IndexedLineSet {
    coord Coordinate { point [ 7 7.5 12, 7 44.84 -72 ] }
    coordIndex [ 0 1 -1 ]
  }
}

DEF Wagonik Transform {
  translation 7 7.5 12
  children [
    Transform {
      translation 0 -0.5 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } }
        geometry Cylinder { radius 0.05 height 1 }
