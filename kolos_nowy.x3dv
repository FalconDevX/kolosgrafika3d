      children USE Okno
    }
    Transform {
      translation -2.51 2.4 0
      rotation 0 1 0 1.57
      children USE Okno
    }
  ]
}


DEF Zegar TimeSensor { cycleInterval 20 loop TRUE }

DEF Ruch PositionInterpolator {
  key [ 0 0.5 1 ]
  keyValue [ 7 7.5 12, 7 44.84 -72, 7 7.5 12 ]
}

ROUTE Zegar.fraction_changed TO Ruch.set_fraction
ROUTE Ruch.value_changed TO Wagonik.set_translation
