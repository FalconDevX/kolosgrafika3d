      translation 0 -1.8 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.9 0.1 0.1 } }
        geometry Box { size 1.6 1.2 1.2 }
      }
    }
    Transform {
      translation 0 -1.7 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.3 0.5 0.8 } }
        geometry Box { size 1.62 0.5 0.9 }
      }
    }
    Transform {
      translation 0 -1.7 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.3 0.5 0.8 } }
        geometry Box { size 1.3 0.5 1.22 }
      }
    }
  ]
}

Transform {
  translation 30 6.5 3
  children [
    Transform {
      translation 0 -3.25 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.95 0.95 1 } }
        geometry Box { size 6 6.5 6 }
      }
    }
    Transform {
      translation 0 2 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.6 0.4 0.2 } }
        geometry Box { size 5 4 5 }
      }
    }
    Transform {
      translation 0 4 0
      rotation 0 0 1 0.785
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.3 0.15 0.05 } }
        geometry Box { size 3.6 3.6 5.4 }
      }
    }
    Transform {
      translation 1.2 5.8 0
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.35 0.35 0.35 } }
        geometry Box { size 0.6 1.6 0.6 }
      }
    }
    Transform {
      translation 0 1.1 2.51
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.3 0.2 0.1 } }
        geometry Box { size 1.2 2.2 0.05 }
      }
    }
    Transform {
      translation -1.7 2.4 2.51
      children DEF Okno Shape {
        appearance Appearance { material Material { diffuseColor 0.6 0.8 1 } }
        geometry Box { size 0.9 0.9 0.05 }
      }
    }
    Transform { translation 1.7 2.4 2.51 children USE Okno }
    Transform {
