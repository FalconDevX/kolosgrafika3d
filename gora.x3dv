#X3D V3.3 utf8
PROFILE Immersive

NavigationInfo { type [ "EXAMINE", "ANY" ] }

Viewpoint {
  position 0 8 40
  orientation 1 0 0 -0.15
}

Background { skyColor [ 0.6 0.75 0.9 ] }

DirectionalLight { direction -1 -1 -1 }

Transform {
  children Shape {
    appearance Appearance { material Material { diffuseColor 1 1 1 } }
    geometry Box { size 60 0.1 60 }
  }
}

Shape {
  appearance Appearance { material Material { diffuseColor 0.95 0.95 1 } }
  geometry IndexedFaceSet {
    solid FALSE
    coord Coordinate {
      point [ -10 0 15, 10 0 15, 10 0 -15, -10 0 -15, -10 10 -15, 10 10 -15 ]
    }
    coordIndex [ 0 1 2 3 -1, 3 2 5 4 -1, 0 1 5 4 -1, 0 3 4 -1, 1 2 5 -1 ]
  }
}

Transform {
  translation 7 1.5 13
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.4 0.4 0.4 } }
    geometry Cylinder { radius 0.15 height 3 }
  }
}

Transform {
  translation 7 11.5 -14
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.4 0.4 0.4 } }
    geometry Cylinder { radius 0.15 height 3 }
  }
}

Shape {
  appearance Appearance { material Material { emissiveColor 0 0 0 } }
  geometry IndexedLineSet {
    coord Coordinate { point [ 7 3 13, 7 13 -14 ] }
    coordIndex [ 0 1 -1 ]
  }
}

DEF Wagonik Transform {
  translation 7 2.4 13
  children Shape {
    appearance Appearance { material Material { diffuseColor 0.9 0.1 0.1 } }
    geometry Box { size 0.8 0.8 0.8 }
  }
}

Transform {
  translation -6 1 20
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.6 0.4 0.2 } }
      geometry Box { size 3 2 3 }
    }
    Transform {
      translation 0 1 0
      rotation 0 0 1 0.785
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.6 0.1 0.1 } }
        geometry Box { size 2.2 2.2 3.2 }
      }
    }
    Transform {
      translation 0 -0.4 1.51
      children Shape {
        appearance Appearance { material Material { diffuseColor 0.3 0.2 0.1 } }
        geometry Box { size 0.7 1.2 0.05 }
      }
    }
  ]
}

DEF Zegar TimeSensor { cycleInterval 10 loop TRUE }

DEF Ruch PositionInterpolator {
  key [ 0 0.5 1 ]
  keyValue [ 7 2.4 13, 7 12.4 -14, 7 2.4 13 ]
}

ROUTE Zegar.fraction_changed TO Ruch.set_fraction
ROUTE Ruch.value_changed TO Wagonik.set_translation
